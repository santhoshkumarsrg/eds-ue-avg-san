  {
    "id": "pricing",
    "fields": [
      {
        "component": "richtext",
        "valueType": "string",
        "name": "features",
        "label": "Features",
        "description": "Left column: intro line, feature bullet list and a 'See all features' link"
      },
      {
        "component": "richtext",
