[
  {
    "id": "page-metadata",
    "fields": [
      {
        "component": "text",
        "valueType": "string",
        "name": "jcr:title",
        "label": "Title"
      },
      {
        "component": "text",
        "valueType": "string",
        "name": "jcr:description",
        "label": "Description"
      },
      {
        "component": "text",
        "valueType": "string",
        "name": "keywords",
        "multi": true,
        "label": "Keywords"
      },
      {
        "component": "text",
        "valueType": "string",
        "name": "lang",
        "label": "Language",
        "description": "Overrides the <html lang> attribute for this page (e.g. en, es-es, ar-sa). Usually set via the bulk metadata sheet for whole sections; use this field only to override a single page."
      },
      {
        "component": "select",
        "valueType": "string",
        "name": "robots",
        "label": "Robots",
        "description": "Controls search engine indexing. Leave empty for the default (index, follow). Pages with noindex are also excluded from the sitemap.",
        "options": [
          {
            "name": "Default (index, follow)",
            "value": ""
          },
          {
            "name": "noindex",
            "value": "noindex"
          },
          {
            "name": "noindex, nofollow",
            "value": "noindex, nofollow"
          }
        ]
      },
      {
        "component": "reference",
        "valueType": "string",
        "name": "og:image",
        "label": "Social Share Image",
        "multi": false,
        "description": "Overrides the automatic og:image/twitter:image (the page's first image) for social shares."
      },
      {
        "component": "aem-content",
        "name": "nav",
        "label": "Navigation Fragment",
        "description": "Optional alternative header/nav fragment for this page. Defaults to /nav."
      },
      {
        "component": "aem-content",
        "name": "footer",
        "label": "Footer Fragment",
        "description": "Optional alternative footer fragment for this page. Defaults to /footer."
      },
      {
        "component": "text",
        "valueType": "string",
        "name": "site-section",
        "label": "Site Section",
        "description": "Analytics site_section. Defaults to avg.com when empty."
      },
      {
        "component": "text",
        "valueType": "string",
        "name": "site-sub-section",
        "label": "Site Sub Section",
        "description": "Analytics site_sub_section. When empty, derived from the URL path."
      },
      {
        "component": "text",
        "valueType": "string",
        "name": "site-sub-sub-section",
        "label": "Site Sub Sub Section",
        "description": "Analytics site_sub_sub_section. When empty, derived from the URL path."
      },
      {
        "component": "text",
        "valueType": "string",
        "name": "page-name",
        "label": "Page Name",
        "description": "Overrides the analytics page_name (defaults to the last URL path segment)."
      },
      {
        "component": "text",
        "valueType": "string",
        "name": "content-title",
        "label": "Content Title",
        "description": "Overrides nortonAnalytics content_title (AEM dnt_contentTitle)."
      },
      {
        "component": "select",
        "valueType": "string",
        "name": "page-type",
        "label": "Page Type",
        "description": "Pushed to SDL as pageType.",
        "options": [
          {
            "name": "",
            "value": ""
          },
          {
            "name": "Category page",
            "value": "categorypage"
          },
          {
            "name": "DTYPage",
            "value": "dtypage"
