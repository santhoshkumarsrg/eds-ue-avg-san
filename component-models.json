  {
    "id": "pricing-plan",
    "fields": [
      {
        "component": "text",
        "valueType": "string",
        "name": "device",
        "label": "Device Tier",
        "description": "e.g. 1 device"
      },
      {
        "component": "reference",
        "name": "platforms",
        "label": "Platform Icon",
        "multi": false,
        "description": "Small icon showing the supported platforms"
      },
      {
        "component": "text",
        "valueType": "string",
        "name": "save",
        "label": "Save Badge",
        "description": "Optional green pill, e.g. Save XX%"
      },
      {
        "component": "richtext",
        "valueType": "string",
        "name": "priceWas",
        "label": "Was / Intro Price",
        "description": "e.g. strike-through the renewal price then the intro price ($XX.XX/first yr)"
      },
      {
        "component": "text",
        "valueType": "string",
        "name": "worksout",
        "label": "Works-out Label",
        "description": "e.g. It works out as"
      },
      {
        "component": "text",
        "valueType": "string",
        "name": "priceCurrency",
        "label": "Price Currency",
        "description": "e.g. $"
      },
      {
        "component": "text",
        "valueType": "string",
        "name": "priceAmount",
        "label": "Price Amount",
        "description": "The large monthly figure, e.g. X.XX"
      },
      {
        "component": "text",
        "valueType": "string",
        "name": "pricePeriod",
        "label": "Price Period",
        "description": "e.g. /month"
      },
      {
        "component": "text",
        "valueType": "string",
        "name": "buyLabel",
        "label": "Buy Label",
        "description": "e.g. Buy now. The buy URL is set automatically to the {buy_link} placeholder and resolved from the pricing API."
      },
      {
        "component": "richtext",
        "valueType": "string",
        "name": "note",
        "label": "Fine Print",
        "description": "Small print under the button (may include a link)"
      },
      {
        "component": "text",
        "valueType": "string",
        "name": "sku",
        "label": "SKU (internal id)",
        "description": "Pricing API internal id, e.g. AGDI-00-001-12. When set, live prices are fetched and {price} tokens are replaced. Rendered as a hidden data attribute."
      },
      {
        "component": "text",
        "valueType": "string",
        "name": "campaignCode",
        "label": "Campaign Code",
        "description": "Pricing API campaign, e.g. WD-HOLIDAYPROMO21. Rendered as a hidden data attribute."
      }
